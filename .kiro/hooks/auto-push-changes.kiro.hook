{
  "enabled": true,
  "name": "Auto Push to GitHub",
  "description": "Automatically commits and pushes all changed files to GitHub after agent stops, so Streamlit Cloud always has the latest code.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "cd c:\\Users\\yujiashi\\Desktop\\SmartSuite_Phase1 && git add -A && git diff --cached --quiet || git commit -m \"auto: sync changes to Streamlit Cloud\" && git push"
  }
}