{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "env": {
    "NEXT_PUBLIC_API_URL": "https://asq6n6kw78.execute-api.us-east-1.amazonaws.com",
    "SITE_AUTH_ENABLED": "true",
    "SITE_AUTH_USER": "smartsuite",
    "SITE_AUTH_PASS": "@site-auth-pass"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}